@using SoloSelfTracking.Interfaces
@using SoloSelfTracking.Models
@using SoloSelfTracking.Repositories
@using SoloSelfTracking.Utilities
@using Microsoft.JSInterop
@implements IPastable
@implements IAsyncDisposable
@inject KillRecordRepository Repository
@inject SettingsRepository UserSettingsRepository
@inject TriggerService TriggerNavigateService
@inject IJSRuntime JS

<PageTitle>@Title</PageTitle>

@if(Bosses.Count() > 1)
{
    <h1>@Title</h1>

    <div class="mb-4">
        <ul class="nav nav-tabs flex-wrap">
            @foreach (var boss in Bosses)
            {
                <li class="nav-item" @key="boss">
                    <button type="button"
                            class="nav-link @(SelectedBoss == boss ? "active" : "")"
                            aria-current="@(SelectedBoss == boss ? "page" : null)"
                            @onclick="() => SelectBoss(boss)">
                        @boss
                    </button>
                </li>
            }
        </ul>
    </div>
}
else if (ShowSoloTitle)
{
    <h1>@Title</h1>
}

@if (!string.IsNullOrEmpty(SelectedBoss))
{
    <div class="card mb-4 p-3">
        <h4>Record @SelectedBoss @Verb</h4>

        @if (Maps.HasValue && Maps.Value == true)
        {
            <div class="d-flex flex-wrap gap-2 mb-3">
                <div class="map-stat">
                    <label for="mapQuantity">IIQ</label>
                    <input id="mapQuantity"
                           type="number"
                           @bind="_mapQuantity" />
                </div>

                <div class="map-stat">
                    <label for="mapRarity">IIR</label>
                    <input id="mapRarity"
                           type="number"
                           @bind="_mapRarity" />
                </div>

                @if (!HasWings.HasValue || (HasWings.HasValue && HasWings == false))
                {
                    <div class="map-stat">
                        <label for="mapAtlasDrops">Atlas Drops</label>
                        <input id="mapAtlasDrops"
                               type="number"
                               @bind="_mapAtlasDrops" />
                    </div>

                    <div class="map-stat">
                        <label for="mapPackSize">Monster Pack Size</label>
                        <input id="mapPackSize"
                               type="number"
                               @bind="_mapPackSize" />
                    </div>
                }


                @if (HasWings.HasValue && HasWings == true)
                {

                    <div class="map-stat">
                        <label for="wings">Revealed Wings</label>
                        <input id="wings"
                               type="number"
                               @bind="_wings" />
                    </div>
                }

                @if (NightmareMods.HasValue && NightmareMods == true)
                {
                    <div class="map-stat">
                        <label for="mapMaps">More Maps</label>
                        <input id="mapMaps"
                               type="number"
                               @bind="_mapMaps" />
                    </div>
                    <div class="map-stat">
                        <label for="mapScarabs">More Scarabs</label>
                        <input id="mapScarabs"
                               type="number"
                               @bind="_mapScarabs" />
                    </div>
                    <div class="map-stat">
                        <label for="mapCurrency">More Currency</label>
                        <input id="mapCurrency"
                               type="number"
                               @bind="_mapCurrency" />
                    </div>

                    <div class="map-stat">
                        <label for="mapDivCards">More Divination Cards</label>
                        <input id="mapDivCards"
                               type="number"
                               @bind="_mapDivCards" />
                    </div>
                }
            </div>
        }

        <div class="drop-search">
            <input type="text"
                   class="drop-search-input"
                   placeholder="Search drops..."
                   @bind="DropSearch"
                   @bind:event="oninput" />

            @if (!string.IsNullOrWhiteSpace(DropSearch))
            {
                <button class="drop-search-clear"
                        type="button"
                        @onclick="() => DropSearch = string.Empty">
                    ×
                </button>
            }
        </div>

        <div class="d-flex flex-wrap gap-2 mb-3">
            @foreach (var drop in CurrentDrops)
            {
                var isSelected = SelectedDrops.Contains(drop.Key);
                var isMatch = !string.IsNullOrWhiteSpace(DropSearch) &&
                    (drop.Item.DisplayName.Contains(
                        DropSearch,
                        StringComparison.OrdinalIgnoreCase) || 
                    drop.Item.BaseType.ToString().Contains(
                        DropSearch.Replace(" ", ""),
                        StringComparison.OrdinalIgnoreCase));
                <ItemHoverInfo Item="drop.Item">
                    <button type="button"
                            class="btn @(isSelected
                                ? "btn-success"
                                : "btn-outline-secondary")
                        @(isMatch ? "drop-search-match" : "")
                        @(!string.IsNullOrWhiteSpace(DropSearch) && !isMatch ? "drop-search-dimmed" : "")"
                            @onclick="() => ToggleDrop(drop)"
                            @oncontextmenu="() => DecrementDrop(drop)"
                            @oncontextmenu:preventDefault>

                        @if (!string.IsNullOrWhiteSpace(drop.Item.IconUrl))
                        {
                            <div class="drop-button-icon-layout">

                                @if (drop.IsMultiple)
                                {
                                    <span class="drop-button-name">
                                        @drop.Item.DisplayName  &nbsp; (@CurrentMultidropRecords.Where(x => string.Equals(x, drop.Key)).Count())</span>
                                }
                                else
                                {
                                    <span class="drop-button-name">
                                        @drop.Item.DisplayName
                                    </span>
                                }

                                

                                <img src="@drop.Item.IconUrl"
                                     class="drop-button-icon"
                                     alt="@drop.Item.DisplayName" />
                            </div>
                        }
                        else
                        {
                            @drop.Item.DisplayName
                        }

                        @if (isSelected && !drop.IsMultiple && string.IsNullOrWhiteSpace(drop.Item.IconUrl))
                        {
                            <span> ✓</span>
                        }
                        else if (isSelected && drop.IsMultiple && string.IsNullOrWhiteSpace(drop.Item.IconUrl))
                        {
                            <span>
                                &nbsp (@CurrentMultidropRecords.Where(x => string.Equals(x, drop.Key)).Count())
                            </span>
                        }
                    </button>
                </ItemHoverInfo>
            }
        </div>
        
        <div class="d-flex flex-wrap gap-2">
            <PerformanceTracker @ref="_performanceTracker"
                                @bind-ElapsedTime="_elapsedTime"
                                @bind-Deaths="_deaths"
                                OnePortal="OnePortal"/>

            <button type="button"
                    class="btn btn-primary"
                    @onclick="RecordKill">
                Record @Verb
            </button>
        </div>
    </div>
}



@if (IsSubPage.HasValue && IsSubPage == true)
{
    
}
else if (!FilteredHistory.Any())
{
    <p class="text-muted">No @Verb recorded for this selection.</p>
}
else
{
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h4>History</h4>

        <div class="d-flex gap-2 align-items-center">
            @if (!string.IsNullOrWhiteSpace(AnalysisHref))
            {
                <div class="nav-item px-3">
                    <NavLink class="bi accordion" href="@AnalysisHref">
                        Analysis
                    </NavLink>
                </div>
            }

            <label for="historyFilter">Show:</label>
            <select id="historyFilter"
                    class="form-select"
                    @bind="HistoryFilter">
                <option value="All">All bosses</option>
                @foreach (var boss in Bosses)
                {
                    <option value="@boss">@boss</option>
                }
            </select>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date and Time</th>
                    @if(Bosses.Count > 1)
                    {
                        <th>Boss</th>
                    }
                    @if (Maps.HasValue && Maps.Value == true)
                    {
                        <th>Map Stats</th>
                    }
                    <th>Drops</th>
                    <th>Time</th>
                    @if (!OnePortal)
                    {
                        <th>Deaths</th>
                    }
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kill in FilteredHistory)
                {
                    <tr @key="kill.Id">
                        <td>@kill.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        @if(Bosses.Count > 1)
                        {
                            <td>
                                <span class="badge bg-primary">
                                    @kill.Boss
                                </span>
                            </td>
                        }

                        @if (Maps.HasValue && Maps.Value == true)
                        {
                            @if(NightmareMods.HasValue && NightmareMods == true)
                            {
                                <td title="IIQ/IIR/Pack Size/Maps/Scarabs/Currency/Div Cards">@string.Format("{0}%/{1}%/{2}%/{3}%/{4}%/{5}%/{6}%/{7}%", kill.MapQuantity, kill.MapRarity, kill.MapAtlasDrops, kill.MapMonsterPackSize, kill.MapMaps, kill.MapScarabs, kill.MapCurrency, kill.MapDivCards)</td>
                            }
                            else if (HasWings.HasValue && HasWings == true)
                            {
                                <td title="IIQ/IIR">@string.Format("{0}%/{1}%/{2} Wings", kill.MapQuantity, kill.MapRarity, kill.Wings)</td>
                            }
                            else
                            {
                                <td title="IIQ/IIR">@string.Format("{0}%/{1}%/{2}%/{3}%", kill.MapQuantity, kill.MapRarity, kill.MapAtlasDrops, kill.MapMonsterPackSize)</td>
                            }
                        }
                        <td>
                            @if (kill.Drops.Count == 0)
                            {
                                <span class="text-muted">
                                    No notable drops
                                </span>
                            }
                            else
                            {
                                @foreach (var drop in kill.Drops)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        <ItemHoverInfo Item="ItemIndex.FindItem(drop.Drop)">
                                            @drop.Drop
                                            @if(drop.Count > 1)
                                            {
                                                <span>(@drop.Count)</span>
                                            }
                                        </ItemHoverInfo>
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary me-1 mb-1">
                                @FormatDuration(kill.ElapsedTime)
                            </span>
                        </td>
                        @if(!OnePortal)
                        {
                            <td>
                                <span class="badge bg-secondary me-1 mb-1">
                                    @kill.Deaths
                                </span>
                            </td>
                        }
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteKill(kill.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<string> Bosses { get; set; } = Array.Empty<string>();

    [Parameter, EditorRequired]
    public Func<string, List<DropTableEntry>> DropProvider { get; set; } = null!;

    [Parameter]
    public string Title { get; set; } = "Boss Tracker";

    [Parameter]
    public string? AnalysisHref { get; set; }

    [Parameter]
    public bool? Maps { get; set; }

    [Parameter]
    public bool? NightmareMods { get; set; }

    [Parameter]
    public bool? IsSubPage { get; set; }

    [Parameter]
    public EventCallback<KillRecord> OnRecordKill { get; set; }

    [Parameter]
    public string Verb { get; set; } = "Kill";
    [Parameter]
    public string VerbPlural { get; set; } = "Kills";
    [Parameter]
    public string NavigationPrefix { get; set; } = "";

    [Parameter]
    public bool OnePortal { get; set; } = false;
    [Parameter]
    public bool ShowSoloTitle { get; set; } = false;


    [Parameter]
    public bool? HasWings { get; set; }


    private string SelectedBoss = string.Empty;
    private string HistoryFilter = "All";
    private string DropSearch = string.Empty;

    private int _nextKillId;
    private HashSet<string> SelectedDrops = new();
    private List<KillRecord> KillHistory = new();
    private List<string> CurrentMultidropRecords = new();

    private TimeSpan _elapsedTime = TimeSpan.Zero;
    private int _deaths;
    private PerformanceTracker? _performanceTracker;

    private int _mapQuantity = 0;
    private int _mapRarity = 0;
    private int _mapPackSize = 0;
    private int _mapScarabs = 0;
    private int _mapCurrency = 0;
    private int _mapDivCards = 0;
    private int _mapMaps = 0;
    private int _mapAtlasDrops = 0;
    private int _wings = 0;

    private Settings UserSettings;
    private TriggerService _navigateService;

    private List<DropOption> CurrentDrops =>
        string.IsNullOrEmpty(SelectedBoss)
            ? new()
            : DropProvider(SelectedBoss)
                .Select(drop => new DropOption(
                    drop.Drop.GetItemKey(),
                    drop.Drop,
                    drop.IsMultiDrop))
                .ToList();

    private IEnumerable<KillRecord> FilteredHistory =>
        KillHistory
            .Where(k => HistoryFilter == "All"
                || k.Boss == HistoryFilter)
            .OrderByDescending(k => k.Date)
            .ThenByDescending(k => k.Id);

    protected override async Task OnInitializedAsync()
    {
        if (Bosses.Count > 0)
            SelectedBoss = Bosses[0];

        var completeHistory = await Repository.GetAllAsync();

        KillHistory = completeHistory
            .Where(x => Bosses.Contains(x.Boss))
            .ToList();

        _nextKillId = completeHistory.Count > 0
            ? completeHistory.Max(x => x.Id) + 1
            : 0;

        UserSettings = await UserSettingsRepository.GetAsync();
        _navigateService = TriggerNavigateService;
        _navigateService.OnTriggerAsync = HandleNavigationTrigger;
        _navigateService.OnTriggerTimerAsync = HandleTimerTrigger;
        _navigateService.OnTriggerTimerPauseAsync = HandleTimerPauseTrigger;
        _navigateService.OnTriggerDeathAsync = HandleDeathTrigger;
    }

    private void SelectBoss(string boss)
    {
        if (SelectedBoss != boss)
        {
            SelectedBoss = boss;
            SelectedDrops.Clear();
            StateHasChanged();
        }
    }

    private void ToggleDrop(DropOption drop)
    {
        if (drop.IsMultiple)
        {
            CurrentMultidropRecords.Add(drop.Key);
            SelectedDrops.Add(drop.Key);
            return;
        }

        if (!SelectedDrops.Add(drop.Key))
            SelectedDrops.Remove(drop.Key);
    }

    private void DecrementDrop(DropOption drop)
    {
        if (!drop.IsMultiple)
        {
            return;
        }

        CurrentMultidropRecords.Remove(drop.Key);

        if (!CurrentMultidropRecords.Contains(drop.Key))
        {
            SelectedDrops.Remove(drop.Key);
        }
    }

    private async Task RecordKill()
    {
        if (string.IsNullOrEmpty(SelectedBoss))
            return;

        // Stop the timer before capturing the record.
        if (_performanceTracker is not null)
            await _performanceTracker.StopTimer();

        var drops = CurrentDrops
            .Where(d => SelectedDrops.Contains(d.Key))
            .Select(d => d.Item)
            .ToList();

        var dropRecord = new List<KillRecordDrop>();
        foreach(var drop in drops)
        {
            dropRecord.Add(new KillRecordDrop()
            {
                Drop = drop.Name,
                Count = CurrentMultidropRecords.Where(x => string.Equals(x, drop.GetItemKey())).Count()
            });
        }

        var record = new KillRecord
        {
            Id = _nextKillId++,
            Date = DateTime.Now,
            Boss = SelectedBoss,
            Drops = dropRecord,
            Deaths = _deaths,
            ElapsedTime = _elapsedTime
        };
        if (Maps.HasValue && Maps.Value == true)
        {
            record.MapQuantity = _mapQuantity;
            record.MapRarity = _mapRarity;
            record.MapMonsterPackSize = _mapPackSize;
            record.MapMaps = _mapMaps;
            record.MapScarabs = _mapScarabs;
            record.MapCurrency = _mapCurrency;
            record.MapDivCards = _mapDivCards;
            record.MapAtlasDrops = _mapAtlasDrops;
            record.Wings = _wings;
        }

        if (IsSubPage.HasValue && IsSubPage == true)
        {
            await OnRecordKill.InvokeAsync(record);
            return;
        }
        else
        {
            KillHistory.Add(record);
            await Repository.AddAsync(record);
            ResetTracker();
        }
    }

    public void ResetTracker()
    {
        ResetMapStats();
        SelectedDrops.Clear();
        CurrentMultidropRecords.Clear();
        _elapsedTime = TimeSpan.Zero;
        _deaths = 0;
        StateHasChanged();
    }

    private async Task DeleteKill(int id)
    {
        KillHistory.RemoveAll(k => k.Id == id);
        await Repository.DeleteAsync(id);
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return $"{(int)duration.TotalHours:D2}:{duration.Minutes:D2}:{duration.Seconds:D2}";
    }

    private sealed class DropOption(string key, Item item, bool isMultiple)
    {
        public string Key { get; } = key;
        public Item Item { get; } = item;
        public bool IsMultiple { get; } = isMultiple;
        public int DropCount { get; set; }
    }

    // Clipboard handling

    private IJSObjectReference? _pasteModule;
    private DotNetObjectReference<BossTracker>? _dotNetReference;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _pasteModule = await JS.InvokeAsync<IJSObjectReference>(
            "import", "./js/pastehelper.js");

        _dotNetReference = DotNetObjectReference.Create(this);

        await _pasteModule.InvokeVoidAsync(
            "attachPasteHandler", _dotNetReference);

        await _pasteModule.InvokeVoidAsync(
            "attachFocusHandler", _dotNetReference);
    }

    [JSInvokable]
    public async Task<bool> HandlePastedItem(string pastedText)
    {
        return await HandlePaste(pastedText);
    }

    [JSInvokable]
    public async Task<bool> HandleFocusedItem(string pastedText)
    {
        if (UserSettings.EnablePasteOnFocusIn)
            return await HandlePaste(pastedText);
        return false;
    }

    private async Task<bool> HandlePaste(string pastedText)
    {
        var lines = pastedText.Split(
            new[] { "\r\n", "\n", "\r" },
            StringSplitOptions.RemoveEmptyEntries);

        if (lines.Length < 3)
            return false;

        var possibleNames = lines
            .Take(3)
            .Select(x => x.Trim());

        var itemType = lines[0].Trim();

        if (string.Equals(itemType, "Item Class: Maps") || string.Equals(itemType, "Item Class: Misc Map Items") || string.Equals(itemType, "Item Class: Blueprints"))
        {
            int currentLineIndex = 5;
            string currentLine = "";
            ResetMapStats();
            while (!string.Equals(currentLine, "--------"))
            {
                currentLine = lines[currentLineIndex];
                if (_mapQuantity == 0)
                    _mapQuantity = ParseMapData(currentLine, "Item Quantity");
                if (_mapRarity == 0)
                    _mapRarity = ParseMapData(currentLine, "Item Rarity");
                if (_mapPackSize == 0)
                    _mapPackSize = ParseMapData(currentLine, "Monster Pack Size");
                if (_mapScarabs == 0)
                    _mapScarabs = ParseMapData(currentLine, "More Scarabs");
                if (_mapCurrency == 0)
                    _mapCurrency = ParseMapData(currentLine, "More Currency");
                if (_mapDivCards == 0)
                    _mapDivCards = ParseMapData(currentLine, "More Divination Cards");
                if (_mapMaps == 0)
                    _mapMaps = ParseMapData(currentLine, "More Maps");
                if (_mapAtlasDrops == 0)
                    _mapAtlasDrops = ParseMapData(currentLine, "Atlas Drops");
                if (_wings == 0)
                    _wings = ParseWingsData(currentLine);
                currentLineIndex++;
            }

            StateHasChanged();
        }
        else
        {
            var matchingDrop = CurrentDrops.FirstOrDefault(drop =>
            possibleNames.Any(name =>
                string.Equals(drop.Item.Name, name,
            StringComparison.OrdinalIgnoreCase) ||
                string.Equals(drop.Item.DisplayName, name,
            StringComparison.OrdinalIgnoreCase)));

            if (matchingDrop is null)
                return false;

            if (SelectedDrops.Add(matchingDrop.Key))
                StateHasChanged();
        }

        if (UserSettings.ClearClipboardOnValidPaste)
        {
            await JS.InvokeAsync<bool>("clipboardUtilities.clear");
        }
        return true;
    }

    public async ValueTask DisposeAsync()
    {
        if (_pasteModule is not null)
        {
            try
            {
                await _pasteModule.InvokeVoidAsync("detachPasteHandler");
                await _pasteModule.DisposeAsync();
            } catch (Exception e){}
        }

        _dotNetReference?.Dispose();
    }

    private int ParseMapData(string line, string title)
    {
        if (line.Contains(title))
            return int.Parse(line.Split(string.Format("{0}: +", title))[1].Split('%')[0]);

        return 0;
    }

    private int ParseWingsData(string line)
    {
        var title = "Wings Revealed: ";
        if (line.Contains(title))
            return int.Parse(line.Split(title)[1].Split('/')[0]);

        return 0;
    }

    private void ResetMapStats()
    {
        _mapQuantity = 0;
        _mapRarity = 0;
        _mapPackSize = 0;
        _mapScarabs = 0;
        _mapCurrency = 0;
        _mapDivCards = 0;
        _mapMaps = 0;
    }


    private async Task HandleNavigationTrigger(string location)
    {
        if (!string.IsNullOrEmpty(NavigationPrefix))
            location = string.Format("{0} {1}", NavigationPrefix, location);
        SelectBoss(location);
        await Task.CompletedTask;
    }

    private async Task HandleTimerTrigger()
    {
        await _performanceTracker.StartTimer();
        await Task.CompletedTask;
    }

    private async Task HandleTimerPauseTrigger()
    {
        await _performanceTracker.StopTimer();
        await Task.CompletedTask;
    }

    private async Task HandleDeathTrigger()
    {
        await _performanceTracker.IncreaseDeaths();
        StateHasChanged();
        await Task.CompletedTask;
    }
}
