@page "/bosses"
@rendermode InteractiveServer
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Models
@using SoloSelfTracking.Models.StaticClasses

<BossTracker Title="Boss Tracker"
             Bosses="bosses"
             DropProvider="GetBossDrops"
             AnalysisHref="boss-analysis" />

@code {
    private readonly string[] bosses =
    {
        "Sirus",
        "Shaper",
        "Elder",
        "Maven",
        "Cortex",
        "Atziri",
        "Incarnation of Neglect",
        "Incarnation of Fear",
        "Incarnation of Dread",
        "Zorath",
        "Farrul",
        "Saqawal",
        "Fenumus",
        "Craiceann",
        "Ahuatotli",
        "Kurgal",
        "Aul",
        "Catarina",
        "Oshabi",
        "Trialmaster",
        "King in the Mists",
        "Black Knight",
        "It That Was"
    };

    private List<DropTableEntry> GetBossDrops(string boss)
    {
        return boss switch
        {
            "Sirus" => DropTables.Sirus,
            "Shaper" => DropTables.Shaper,
            "Elder" => DropTables.Elder,
            "Maven" => DropTables.Maven,
            "Cortex" => DropTables.Cortex,
            "Atziri" => DropTables.Atziri,
            "Incarnation of Neglect" => DropTables.IncarnationOfNeglect,
            "Incarnation of Fear" => DropTables.IncarnationOfFear,
            "Incarnation of Dread" => DropTables.IncarnationOfDread,
            "Zorath" => DropTables.Zorath,
            "Farrul" => DropTables.Farrul,
            "Saqawal" => DropTables.Saqawal,
            "Fenumus" => DropTables.Fenumus,
            "Craiceann" => DropTables.Craiceann,
            "Ahuatotli" => DropTables.Ahuatotli,
            "Kurgal" => DropTables.Kurgal,
            "Aul" => DropTables.Aul,
            "Catarina" => DropTables.Catarina,
            "Oshabi" => DropTables.Oshabi,
            "Trialmaster" => DropTables.Trialmaster,
            "King in the Mists" => DropTables.KingInTheMists,
            "Black Knight" => DropTables.BlackKnight,
            "It That Was" => DropTables.ItThatWas,
            _ => new List<DropTableEntry>()
        };
    }
}
