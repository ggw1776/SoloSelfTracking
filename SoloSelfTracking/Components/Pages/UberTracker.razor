@page "/ubers"
@rendermode InteractiveServer
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Models
@using SoloSelfTracking.Models.StaticClasses

<BossTracker Title="Uber Tracker"
             Bosses="bosses"
             DropProvider="GetBossDrops"
             AnalysisHref="uber-analysis"
             NavigationPrefix="Uber"/>

@code {
    private readonly string[] bosses =
    {
        "Uber Sirus",
        "Uber Shaper",
        "Uber Uber Elder",
        "Uber Maven",
        "Uber Cortex",
        "Uber Exarch",
        "Uber Eater",
        "Uber Incarnation of Neglect",
        "Uber Incarnation of Fear",
        "Uber Incarnation of Dread"
    };

    private List<DropTableEntry> GetBossDrops(string boss)
    {
        return boss switch
        {
            "Uber Sirus" => DropTables.UberSirus,
            "Uber Shaper" => DropTables.UberShaper,
            "Uber Uber Elder" => DropTables.UberUberElder,
            "Uber Maven" => DropTables.UberMaven,
            "Uber Cortex" => DropTables.UberCortex,
            "Uber Exarch" => DropTables.UberExarch,
            "Uber Eater" => DropTables.UberEater,
            "Uber Incarnation of Neglect" => DropTables.UberIncarnationOfNeglect,
            "Uber Incarnation of Fear" => DropTables.UberIncarnationOfFear,
            "Uber Incarnation of Dread" => DropTables.UberIncarnationOfDread,
            _ => new List<DropTableEntry>()
        };
    }
}
