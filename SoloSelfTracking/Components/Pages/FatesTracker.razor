@page "/fates"
@rendermode InteractiveServer

@using System.Reflection
@using System.Text.RegularExpressions
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Enumerations
@using SoloSelfTracking.Models
@using SoloSelfTracking.Models.StaticClasses
@using SoloSelfTracking.Repositories
@using SoloSelfTracking.Utilities

@inject FateRecordRepository Repository

<div class="fate-selection">

    <div class="fate-selection-section">
        <div class="fate-selection-header">
            <h4>Fates</h4>
            <span>@SelectedFates.Count / 3 Selected</span>
        </div>
        <div class="fate-search">
            <input type="text"
                   placeholder="Search fates..."
                   @bind="FateSearch"
                   @bind:event="oninput" />
        </div>

        <div class="fate-selection-grid">
            @foreach (var fate in FilteredFateOptions)
            {
                bool isSelected = SelectedFates.Contains(fate.Value);
                bool isDisabled = SelectedFates.Count >= 3 && !isSelected;

                <button type="button"
                        class="fate-selection-card @(isSelected ? "selected" : "")"
                        disabled="@isDisabled"
                        @onclick="() => ToggleFate(fate.Value)">

                    <span>@fate.Name</span>

                    @if (isSelected)
                    {
                        <span class="fate-selected-indicator">✓</span>
                    }
                </button>
            }
        </div>
    </div>

    <div class="fate-selection-section">
        <div class="fate-selection-header">
            <h4>Rewards</h4>
            <span>@SelectedRewards.Count Selected</span>
        </div>
        <div class="fate-search">
            <input type="text"
                   placeholder="Search rewards..."
                   @bind="RewardSearch"
                   @bind:event="oninput" />
        </div>
        <div class="fate-reward-list">
            @foreach (var reward in FilteredRewardOptions)
            {
                int count = SelectedRewards.Count(x => x.Equals(reward));

                <div class="fate-reward-row @(count > 0 ? "selected" : "")">
                    <span class="fate-reward-name">
                        @FormatRewardName(reward)
                    </span>

                    <div class="fate-reward-controls">
                        <button type="button"
                                class="fate-reward-button"
                                disabled="@(count == 0)"
                                @onclick="() => RemoveReward(reward)">
                            −
                        </button>

                        <span class="fate-reward-count">@count</span>

                        <button type="button"
                                class="fate-reward-button"
                                @onclick="() => AddReward(reward)">
                            +
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

<BossTracker Title="Fate Tracker"
             Bosses="bosses"
             DropProvider="GetBossDrops"
             AnalysisHref="fates-analysis"
             IsSubPage="true"
             OnRecordKill="HandleRecordKill"
             Maps="true"
             NightmareMods="true"
             Verb="Map"
             VerbPlural="Maps"
             @ref="_bossTracker" />


    <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
        <h4>History</h4>

        <div class="d-flex gap-2 align-items-center">
            <div class="nav-item px-3">
                <NavLink class="bi accordion" href="fates-analysis">
                    Analysis
                </NavLink>
            </div>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Date and Time</th>
                    <th>Drops</th>
                    <th>Map Time</th>
                    <th>Deaths</th>
                    <th>Fates</th>
                    <th>Rewards</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var kill in FateRecords)
                {
                    <tr @key="kill.Id">
                        <td>@kill.Date.ToString("yyyy-MM-dd HH:mm:ss")</td>
                        <td>
                            @if (kill.Drops.Count == 0)
                            {
                                <span class="text-muted">
                                    No notable drops
                                </span>
                            }
                            else
                            {
                                @foreach (var drop in kill.Drops)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        <ItemHoverInfo Item="ItemIndex.FindItem(drop.Drop)">
                                            @drop.Drop
                                            @if (drop.Count > 1)
                                            {
                                                <span>(@drop.Count)</span>
                                            }
                                        </ItemHoverInfo>
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            <span class="badge bg-secondary me-1 mb-1">
                                @FormatDuration(kill.ElapsedTime)
                            </span>
                        </td>
                        <td>
                            <span class="badge bg-secondary me-1 mb-1">
                                @kill.Deaths
                            </span>
                        </td>
                        <td>
                            @if (kill.Fates.Count == 0)
                            {
                                <span class="text-muted">
                                    No fates recorded
                                </span>
                            }
                            else
                            {
                                @foreach (var fate in kill.Fates)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        @fate.Name
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            @if (kill.Reward.Count == 0)
                            {
                                <span class="text-muted">
                                    No rewards badges
                                </span>
                            }
                            else
                            {
                                @foreach (var reward in kill.Reward)
                                {
                                    <span class="badge bg-secondary me-1 mb-1">
                                        @FormatRewardName(reward)
                                    </span>
                                }
                            }
                        </td>
                        <td>
                            <button type="button"
                                    class="btn btn-sm btn-outline-danger"
                                    @onclick="() => DeleteKill(kill.Id)">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@code {
    private readonly string[] bosses =
    {
        "Fates"
    };

    private List<DropTableEntry> GetBossDrops(string boss)
    {
        return boss switch
        {
            "Fates" => DropTables.Fates,
            _ => new List<DropTableEntry>()
        };
    }

    private List<FateRecord> FateRecords = new();

    private List<Fate> SelectedFates = new();
    private List<EFateReward> SelectedRewards = new();

    private int _nextKillId = 1;
    private BossTracker _bossTracker;

    private record FateOption(string Name, Fate Value);

    protected override async Task OnInitializedAsync()
    {
        FateRecords = await Repository.GetAllAsync();

        _nextKillId = FateRecords.Count > 0
            ? FateRecords.Max(x => x.Id) + 1
            : 0;
    }

    private List<FateOption> FateOptions =>
        typeof(Fates)
            .GetFields(BindingFlags.Public | BindingFlags.Static)
            .Where(x => typeof(Fate).IsAssignableFrom(x.FieldType))
            .Select(x => new FateOption(
                FormatFateName(x.Name),
                (Fate)x.GetValue(null)!))
            .Concat(
                typeof(Fates)
                    .GetProperties(BindingFlags.Public | BindingFlags.Static)
                    .Where(x => x.CanRead && typeof(Fate).IsAssignableFrom(x.PropertyType))
                    .Select(x => new FateOption(
                        FormatFateName(x.Name),
                        (Fate)x.GetValue(null)!)))
            .Where(x => x.Value != null)
            .GroupBy(x => x.Name)
            .Select(x => x.First())
            .OrderBy(x => x.Name)
            .ToList();

    private List<EFateReward> RewardOptions =>
        Enum.GetValues<EFateReward>().ToList();

    private string FateSearch = string.Empty;
    private string RewardSearch = string.Empty;

    private List<FateOption> FilteredFateOptions =>
        FateOptions
            .Where(x => string.IsNullOrWhiteSpace(FateSearch) ||
                x.Name.Contains(FateSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private List<EFateReward> FilteredRewardOptions =>
        RewardOptions
            .Where(x => string.IsNullOrWhiteSpace(RewardSearch) ||
                FormatRewardName(x).Contains(RewardSearch, StringComparison.OrdinalIgnoreCase))
            .ToList();

    private void ToggleFate(Fate fate)
    {
        if (SelectedFates.Contains(fate))
        {
            SelectedFates.Remove(fate);
            return;
        }

        if (SelectedFates.Count >= 3)
            return;

        SelectedFates.Add(fate);
    }

    private void AddReward(EFateReward reward)
    {
        SelectedRewards.Add(reward);
    }

    private void RemoveReward(EFateReward reward)
    {
        SelectedRewards.Remove(reward);
    }

    private string FormatFateName(string name)
    {
        return Regex.Replace(name, "([a-z])([A-Z])", "$1 $2");
    }

    private string FormatRewardName(EFateReward reward)
    {
        return Regex.Replace(reward.ToString(), "([a-z])([A-Z])", "$1 $2");
    }

    private async Task HandleRecordKill(KillRecord killRecord)
    {
        if (SelectedFates.Any())
        {
            var record = new FateRecord()
            {
                Id = _nextKillId++,
                Fates = SelectedFates.ToList(),
                Reward = SelectedRewards.ToList()
            };

            KillRecordUtilities<FateRecord>.ApplyKillRecord(record, killRecord);

            await Repository.AddAsync(record);

            FateRecords = await Repository.GetAllAsync();

            _nextKillId = FateRecords.Count > 0
                ? FateRecords.Max(x => x.Id) + 1
                : 1;

            SelectedFates.Clear();
            SelectedRewards.Clear();

            _bossTracker.ResetTracker();

            StateHasChanged();
        }
    }

    private static string FormatDuration(TimeSpan duration)
    {
        return $"{(int)duration.TotalHours:D2}:{duration.Minutes:D2}:{duration.Seconds:D2}";
    }

    private async Task DeleteKill(int id)
    {
        FateRecords.RemoveAll(k => k.Id == id);
        await Repository.DeleteAsync(id);
    }
}