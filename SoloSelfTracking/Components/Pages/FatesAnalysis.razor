@page "/fates-analysis"
@rendermode InteractiveServer
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Models
@using SoloSelfTracking.Repositories
@inject FateRecordRepository Repository

<BossAnalysis Title="Fates Analysis" Bosses="Bosses" Maps="true" Nightmare="true" />


@if (isLoading)
{
}
else
{
    <section class="mb-5">
        <h4>Fate analysis</h4>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Fate</th>
                        <th class="text-end">Fate Appearances</th>
                        <th class="text-end">Overall Rate</th>
                        <th class="text-end">Missing Count</th>
                        <th class="text-end">Missing Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fate in FateAnalysisRecords)
                    {
                        <tr>
                            <td>@fate.Fate</td>
                            <td class="text-end">@fate.FateAppearances</td>
                            <td class="text-end">@fate.OpenRoomOverallRate.ToString("F1")%</td>
                            <td class="text-end">@fate.MissingCount</td>
                            <td class="text-end">@fate.MissingRate.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
    <section class="mb-5">
        <h4>Reward analysis</h4>

        <div class="table-responsive">
            <table class="table table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Reward</th>
                        <th class="text-end">Reward Appearances</th>
                        <th class="text-end">Overall Rate</th>
                        <th class="text-end">Missing Count</th>
                        <th class="text-end">Missing Rate</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reward in RewardAnalysisRecords)
                    {
                        <tr>
                            <td>@reward.Reward</td>
                            <td class="text-end">@reward.RewardAppearances</td>
                            <td class="text-end">@reward.OpenRoomOverallRate.ToString("F1")%</td>
                            <td class="text-end">@reward.MissingCount</td>
                            <td class="text-end">@reward.MissingRate.ToString("F1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

@code {
    private static readonly List<string> Bosses = new()
    {
        "Fates"
    };

    private bool isLoading = true;
    private List<FateRecord> History = new();
    private List<FateAnalysisRecord> FateAnalysisRecords = new();
    private List<RewardAnalysisRecord> RewardAnalysisRecords = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            History = (await Repository.GetAllAsync()).ToList();
            GenerateFateStatistics();
            GenerateRewardStatistics();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void GenerateFateStatistics()
    {
        FateAnalysisRecords.Clear();

        int totalRecords = History.Count;

        if (totalRecords == 0)
            return;

        var fateNames = History
            .SelectMany(r => r.Fates)
            .Select(r => r.Name)
            .Distinct(StringComparer.OrdinalIgnoreCase);

        foreach (var fate in fateNames)
        {
            int fateCount = History.Count(r =>
                r.Fates.Any(x =>
                    string.Equals(x.Name, fate,
                        StringComparison.OrdinalIgnoreCase)));


            FateAnalysisRecords.Add(new FateAnalysisRecord
            {
                Fate = fate,
                FateAppearances = fateCount,
                OpenRoomOverallRate = (double)fateCount / totalRecords * 100,
                MissingCount = totalRecords - fateCount,
                MissingRate = (double)(totalRecords - fateCount) / totalRecords * 100
            });
        }

        FateAnalysisRecords = FateAnalysisRecords
            .OrderBy(x => x.Fate)
            .ToList();
    }

    private void GenerateRewardStatistics()
    {
        RewardAnalysisRecords.Clear();

        int totalRecords = History.Count;

        if (totalRecords == 0)
            return;

        var rewardNames = History
            .SelectMany(r => r.Reward)
            .Distinct()
            .ToList();

        foreach (var reward in rewardNames)
        {
            int rewardCount = History.Count(r =>
                r.Reward.Contains(reward));

            RewardAnalysisRecords.Add(new RewardAnalysisRecord
            {
                Reward = reward.ToString(),
                RewardAppearances = rewardCount,
                OpenRoomOverallRate = (double)rewardCount / totalRecords * 100,
                MissingCount = totalRecords - rewardCount,
                MissingRate = (double)(totalRecords - rewardCount) / totalRecords * 100
            });
        }

        RewardAnalysisRecords = RewardAnalysisRecords
            .OrderBy(x => x.Reward)
            .ToList();
    }


    public class FateAnalysisRecord
    {
        public string Fate { get; set; } = string.Empty;
        public int FateAppearances { get; set; }
        public double OpenRoomOverallRate { get; set; }
        public int MissingCount { get; set; }
        public double MissingRate { get; set; }
    }


    public class RewardAnalysisRecord
    {
        public string Reward { get; set; } = string.Empty;
        public int RewardAppearances { get; set; }
        public double OpenRoomOverallRate { get; set; }
        public int MissingCount { get; set; }
        public double MissingRate { get; set; }
    }
}