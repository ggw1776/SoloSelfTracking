@page "/anomaly"
@rendermode InteractiveServer
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Models
@using SoloSelfTracking.Models.StaticClasses

<BossTracker Title="Anomaly Rush Tracker"
             Bosses="bosses"
             DropProvider="GetBossDrops"
             AnalysisHref="anomaly-analysis"
             Maps="true"
             NightmareMods="true"
             Verb="Map" 
             VerbPlural="Maps" />

@code {
    private readonly string[] bosses =
    {
        "North West",
        "North East",
        "South West",
        "South East"
    };

    private List<DropTableEntry> GetBossDrops(string boss)
    {
        return boss switch
        {
            "North West" => DropTables.NorthWest,
            "North East" => DropTables.NorthEast,
            "South West" => DropTables.SouthWest,
            "South East" => DropTables.SouthEast,
            _ => new List<DropTableEntry>()
        };
    }
}
