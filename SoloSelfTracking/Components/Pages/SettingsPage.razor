@page "/settings"
@using SoloSelfTracking.Models
@using SoloSelfTracking.Repositories
@rendermode InteractiveServer
@inject SettingsRepository SettingsRepository

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <h3>Settings</h3>
    <p class="settings-description">
        Configure application behavior and preferences.
    </p>

    @if (StoredSettings == null)
    {
        <p>Loading settings...</p>
    }
    else
    {
        <div class="settings-section">
            <h5>Clipboard</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="pasteOnFocus">Enable Paste on Focus-In</label>
                    <p>
                        Automatically trigger paste handling when the tab receives focus (note: your browser may prompt you for this permission as well).
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="pasteOnFocus"
                           type="checkbox"
                           checked="@StoredSettings.EnablePasteOnFocusIn"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnablePasteOnFocusIn), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="clearClipboard">
                        Clear Clipboard After Valid Paste
                    </label>
                    <p>
                        Clear clipboard contents after successfully processing
                        a valid paste.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="clearClipboard"
                           type="checkbox"
                           checked="@StoredSettings.ClearClipboardOnValidPaste"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.ClearClipboardOnValidPaste), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>
        </div>

        <div class="settings-section">
            <h5>Client.txt Monitor</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableLogReader">Enable Log Monitor</label>
                    <p>
                        Shows a Client.txt monitor on most pages.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableLogReader"
                           type="checkbox"
                           checked="@StoredSettings.EnableLogReader"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableLogReader), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableTeleportScrollNotification">
                        Enable Teleport Scroll Reminder
                    </label>
                    <p>
                        Shows a pop-up and plays a sound after every 35 times returning to hideout.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableTeleportScrollNotification"
                           type="checkbox"
                           checked="@StoredSettings.EnableTeleportScrollNotification"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableTeleportScrollNotification), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            
            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableAutoTabNavigation">
                        Enable Auto Navigation
                    </label>
                    <p>
                        Moves you to the appropriate tab when navigating into a zone. Does not change page.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableAutoTabNavigation"
                           type="checkbox"
                           checked="@StoredSettings.EnableAutoTabNavigation"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableAutoTabNavigation), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableAutomaticTimerStart">
                        Enable Auto Timer Start
                    </label>
                    <p>
                        Starts your timer automatically when entering the appropriate zone. Requires Auto Navigation.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableAutomaticTimerStart"
                           type="checkbox"
                           checked="@StoredSettings.EnableAutomaticTimerStart"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableAutomaticTimerStart), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>


            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableAutoDeathCounter">
                        Enable Auto Death Counter
                    </label>
                    <p>
                        Increments the death counter automatically.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableAutoDeathCounter"
                           type="checkbox"
                           checked="@StoredSettings.EnableAutoDeathCounter"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableAutoDeathCounter), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>
        </div>

        <div class="settings-section">
            <h5>Fun Settings</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableShopMusic">Enable Shop Music</label>
                    <p>
                        Plays shop music whenever engaging with a window shopping-type mechanic (currently non-functional).
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableShopMusic"
                           type="checkbox"
                           checked="@StoredSettings.EnableShopMusic"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableShopMusic), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableMoralSupport">
                        Enable Moral Support
                    </label>
                    <p>
                        Shows the moral support page, for when you're feeling down (currently non-functional).
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableMoralSupport"
                           type="checkbox"
                           checked="@StoredSettings.EnableMoralSupport"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableMoralSupport), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableTradieDetector">
                        Enable Tr*die Detector
                    </label>
                    <p>
                        Shows the tradie detector page, for when you notice people getting a slightly too lucky (currently non-functional).
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableTradieDetector"
                           type="checkbox"
                           checked="@StoredSettings.EnableTradieDetector"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableTradieDetector), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>
        </div>

        <div class="settings-save-status">
            @if (IsSaving)
            {
                <span>Saving...</span>
            }
            else if (HasSaved)
            {
                <span>Settings saved.</span>
            }
        </div>
    }
</div>

@code {
    private Settings? StoredSettings;
    private bool IsSaving;
    private bool HasSaved;

    protected override async Task OnInitializedAsync()
    {
        StoredSettings = await SettingsRepository.GetAsync();
    }

    private async Task UpdateSetting(string settingName, ChangeEventArgs args)
    {
        if (StoredSettings == null)
            return;

        bool value = args.Value is bool enabled && enabled;

        switch (settingName)
        {
            case nameof(StoredSettings.EnablePasteOnFocusIn):
                StoredSettings.EnablePasteOnFocusIn = value;
                break;
            case nameof(StoredSettings.ClearClipboardOnValidPaste):
                StoredSettings.ClearClipboardOnValidPaste = value;
                break;
            case nameof(StoredSettings.EnableIframing):
                StoredSettings.EnableIframing = value;
                break;
            case nameof(StoredSettings.EnableLogReader):
                StoredSettings.EnableLogReader = value;
                break;
            case nameof(StoredSettings.EnableTeleportScrollNotification):
                StoredSettings.EnableTeleportScrollNotification = value;
                break;
            case nameof(StoredSettings.EnableAutomaticTimerStart):
                StoredSettings.EnableAutomaticTimerStart = value;
                break;
            case nameof(StoredSettings.EnableShopMusic):
                StoredSettings.EnableShopMusic = value;
                break;
            case nameof(StoredSettings.EnableMoralSupport):
                StoredSettings.EnableMoralSupport = value;
                break;
            case nameof(StoredSettings.EnableTradieDetector):
                StoredSettings.EnableTradieDetector = value;
                break;
            case nameof(StoredSettings.EnableAutoTabNavigation):
                StoredSettings.EnableAutoTabNavigation = value;
                break;
            case nameof(StoredSettings.EnableAutoDeathCounter):
                StoredSettings.EnableAutoDeathCounter = value;
                break;
            case nameof(StoredSettings.EnableAutoMapParse):
                StoredSettings.EnableAutoMapParse = value;
                break;
            default:
                return;
        }

        IsSaving = true;
        HasSaved = false;

        try
        {
            await SettingsRepository.SaveAsync(StoredSettings);
            HasSaved = true;
        }
        finally
        {
            IsSaving = false;
        }
    }
}