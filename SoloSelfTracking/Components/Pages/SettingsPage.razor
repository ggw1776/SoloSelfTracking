@code {
    private Settings? StoredSettings;
    private bool IsSaving;
    private bool HasSaved;

    protected override async Task OnInitializedAsync()
    {
        StoredSettings = await SettingsRepository.GetAsync();
    }

    private async Task UpdateSetting(string settingName, ChangeEventArgs args)
    {
        if (StoredSettings == null)
            return;

        bool value = args.Value is bool enabled && enabled;

        switch (settingName)
        {
            case nameof(StoredSettings.EnablePasteOnFocusIn):
                StoredSettings.EnablePasteOnFocusIn = value;
                break;
            case nameof(StoredSettings.ClearClipboardOnValidPaste):
                StoredSettings.ClearClipboardOnValidPaste = value;
                break;
            case nameof(StoredSettings.EnableIframing):
                StoredSettings.EnableIframing = value;
                break;
            case nameof(StoredSettings.EnableLogReader):
                StoredSettings.EnableLogReader = value;
                break;
            case nameof(StoredSettings.EnableTeleportScrollNotification):
                StoredSettings.EnableTeleportScrollNotification = value;
                break;
            case nameof(StoredSettings.EnableAutomaticTimerStart):
                StoredSettings.EnableAutomaticTimerStart = value;
                break;
            case nameof(StoredSettings.EnableShopMusic):
                StoredSettings.EnableShopMusic = value;
                break;
            case nameof(StoredSettings.EnableMoralSupport):
                StoredSettings.EnableMoralSupport = value;
                break;
            case nameof(StoredSettings.EnableTradieDetector):
                StoredSettings.EnableTradieDetector = value;
                break;
            case nameof(StoredSettings.EnableAutoTabNavigation):
                StoredSettings.EnableAutoTabNavigation = value;
                break;
            case nameof(StoredSettings.EnableAutoDeathCounter):
                StoredSettings.EnableAutoDeathCounter = value;
                break;
            case nameof(StoredSettings.EnableAutoMapParse):
                StoredSettings.EnableAutoMapParse = value;
                break;
            case nameof(StoredSettings.EnablePauseTimerOnEnterHideout):
                StoredSettings.EnablePauseTimerOnEnterHideout = value;
                break;
            case nameof(StoredSettings.EnableFates):
                StoredSettings.EnableFates = value;
                break;

            case nameof(StoredSettings.EnableAnomaly):
                StoredSettings.EnableAnomaly = value;
                break;

            case nameof(StoredSettings.EnableSimulacrum):
                StoredSettings.EnableSimulacrum = value;
                break;

            case nameof(StoredSettings.EnableSanctum):
                StoredSettings.EnableSanctum = value;
                break;

            case nameof(StoredSettings.EnableIncursion):
                StoredSettings.EnableIncursion = value;
                break;

            case nameof(StoredSettings.EnableNightmares):
                StoredSettings.EnableNightmares = value;
                break;

            case nameof(StoredSettings.EnableBosses):
                StoredSettings.EnableBosses = value;
                break;

            case nameof(StoredSettings.EnableInviteBosses):
                StoredSettings.EnableInviteBosses = value;
                break;

            case nameof(StoredSettings.EnableUbers):
                StoredSettings.EnableUbers = value;
                break;

            case nameof(StoredSettings.EnableT0s):
                StoredSettings.EnableT0s = value;
                break;

            case nameof(StoredSettings.EnableTimeline):
                StoredSettings.EnableTimeline = value;
                break;

            case nameof(StoredSettings.EnableStash):
                StoredSettings.EnableStash = value;
                break;

            case nameof(StoredSettings.EnableRegexDictionary):
                StoredSettings.EnableRegexDictionary = value;
                break;

            case nameof(StoredSettings.EnableHeist):
                StoredSettings.EnableHeist = value;
                break;

            case nameof(StoredSettings.EnableLab):
                StoredSettings.EnableLab = value;
                break;

            case nameof(StoredSettings.EnableWombgifts):
                StoredSettings.EnableWombgifts = value;
                break;

            case nameof(StoredSettings.EnableMappingStrats):
                StoredSettings.EnableMappingStrats = value;
                break;

            case nameof(StoredSettings.EnableExpedition):
                StoredSettings.EnableExpedition = value;
                break;

            case nameof(StoredSettings.EnableKingsmarchShipping):
                StoredSettings.EnableKingsmarchShipping = value;
                break;
                
            case nameof(StoredSettings.EnableKingsmarchMapping):
                StoredSettings.EnableKingsmarchMapping = value;
                break;
            case nameof(StoredSettings.EnableWikiSearch):
                StoredSettings.EnableWikiSearch = value;
                break;
            case nameof(StoredSettings.EnablePoeDbSearch):
                StoredSettings.EnablePoeDbSearch = value;
                break;
            case nameof(StoredSettings.EnableBlight):
                StoredSettings.EnableBlight = value;
                break;
            case nameof(StoredSettings.EnableHideOnSearch):
                StoredSettings.EnableHideOnSearch = value;
                break;
            case nameof(StoredSettings.EnableSmartDisplay):
                StoredSettings.EnableSmartDisplay = value;
                break;
            default:
                return;
        }

        IsSaving = true;
        HasSaved = false;

        try
        {
            await SettingsRepository.SaveAsync(StoredSettings);
            HasSaved = true;
        }
        finally
        {
            IsSaving = false;
        }
    }
}