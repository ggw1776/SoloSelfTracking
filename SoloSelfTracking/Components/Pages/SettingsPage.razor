@page "/settings"
@using SoloSelfTracking.Models
@using SoloSelfTracking.Repositories
@rendermode InteractiveServer
@inject SettingsRepository SettingsRepository

<PageTitle>Settings</PageTitle>

<div class="settings-page">
    <h3>Settings</h3>
    <p class="settings-description">
        Configure application behavior and preferences.
    </p>

    @if (StoredSettings == null)
    {
        <p>Loading settings...</p>
    }
    else
    {
        <div class="settings-section">
            <h5>Clipboard</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="pasteOnFocus">Enable Paste on Focus-In</label>
                    <p>
                        Automatically trigger paste handling when the tab receives focus (note: your browser may prompt you for this permission as well).
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="pasteOnFocus"
                           type="checkbox"
                           checked="@StoredSettings.EnablePasteOnFocusIn"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnablePasteOnFocusIn), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="clearClipboard">
                        Clear Clipboard After Valid Paste
                    </label>
                    <p>
                        Clear clipboard contents after successfully processing
                        a valid paste.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="clearClipboard"
                           type="checkbox"
                           checked="@StoredSettings.ClearClipboardOnValidPaste"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.ClearClipboardOnValidPaste), e)" />
                           <span class="setting-slider"></span>
                       </label>
            </div>
        </div>

        <div class="settings-section">
            <h5>Display Settings</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableHideOnSearch">Enable Hide On Search</label>
                    <p>
                        Hides drops that don't match your search instead of dimming them.
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableHideOnSearch"
                           type="checkbox"
                           checked="@StoredSettings.EnableHideOnSearch"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableHideOnSearch), e)" />
<span class="setting-slider"></span>
</label>
            </div>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableSmartDisplay">
                        Enable Smart Display
                    </label>
                    <p>
                        Hides all drops by default, and will only show them when pasted in. This setting is not recommende.d
                    </p>
                </div>

                <label class="setting-switch">
                    <input id="EnableSmartDisplay"
                           type="checkbox"
                           checked="@StoredSettings.EnableSmartDisplay"
                           @onchange="e => UpdateSetting(
                               nameof(StoredSettings.EnableSmartDisplay), e)" />
<span class="setting-slider"></span>
</label>
            </div>
        </div>

        <div class="settings-section">
            <h5>Client.txt Monitor</h5>

            <div class="setting-row">
                <div class="setting-info">
                    <label for="EnableLogReader">Enable Log Monitor</label>
