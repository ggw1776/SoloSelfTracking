@page "/nightmares"
@rendermode InteractiveServer
@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Models
@using SoloSelfTracking.Models.StaticClasses

<BossTracker Title="Nightmare Tracker"
             Bosses="bosses"
             DropProvider="GetBossDrops"
             Maps="true"
             NightmareMods="true"
             AnalysisHref="nightmare-analysis" />

@code {
    private readonly string[] bosses =
    {
        "Citadel",
        "Abomination",
        "Fortress",
        "Sanctuary",
        "Ziggaurat"
    };

    private List<DropTableEntry> GetBossDrops(string boss)
    {
        return boss switch
        {
            "Citadel" => DropTables.Citadel,
            "Abomination" => DropTables.Abomination,
            "Fortress" => DropTables.Fortress,
            "Sanctuary" => DropTables.Sanctuary,
            "Ziggaurat" => DropTables.Ziggaurat,
            _ => new List<DropTableEntry>()
        };
    }
}
