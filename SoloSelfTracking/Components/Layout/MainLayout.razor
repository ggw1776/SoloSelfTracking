@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Repositories
@inherits LayoutComponentBase
@inject SettingsRepository Repository

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@if (EnableLogReader)
{
    <LogMonitor />
}

@code{
    private bool EnableLogReader = false;
    protected override async Task OnInitializedAsync()
    {
        EnableLogReader = (await Repository.GetAsync()).EnableLogReader;
    }
}