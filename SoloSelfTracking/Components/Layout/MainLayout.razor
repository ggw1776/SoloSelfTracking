@using SoloSelfTracking.Components.Fragments
@using SoloSelfTracking.Repositories
@inherits LayoutComponentBase
@inject SettingsRepository Repository

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

<div class="widget-container">

    @if (EnablePoeDbSearch)
    {
        <WikiWidget SearchUrl="https://poedb.tw/us/search?q=" DisplayUrl="poedb" />
    }

    @if (EnableWikiSearch)
    {
        <WikiWidget />
    }

    @if (EnableLogReader)
    {
        <LogMonitor />
    }
</div>


@code {
    private bool EnableLogReader = false;
    private bool EnableWikiSearch = false;
    private bool EnablePoeDbSearch = false;
    protected override async Task OnInitializedAsync()
    {
        var settings = await Repository.GetAsync();
        EnableLogReader = settings.EnableLogReader;
        EnableWikiSearch = settings.EnableWikiSearch;
        EnablePoeDbSearch = settings.EnablePoeDbSearch;
    }
}