@using SoloSelfTracking.Models
@using SoloSelfTracking.Repositories
@inject SettingsRepository Repository

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Solo Self Tracking</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        @if (StoredSettings != null && StoredSettings.EnableRegexDictionary)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="regex">
                    <span class="bi bi-regex-fill-nav-menu" aria-hidden="true"></span> Regex
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableFates)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="fates">
                    <span class="bi bi-fates-fill-nav-menu" aria-hidden="true"></span> Fates
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableAnomaly)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="anomaly">
                    <span class="bi bi-anomaly-fill-nav-menu" aria-hidden="true"></span> Anomaly
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableSimulacrum)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="simulacrum">
                    <span class="bi bi-simu-fill-nav-menu" aria-hidden="true"></span> Simulacrum
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableSanctum)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="sanctum">
                    <span class="bi bi-sanctum-fill-nav-menu" aria-hidden="true"></span> Sanctum
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableIncursion)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="incursion-tracking">
                    <span class="bi bi-incursion-fill-nav-menu" aria-hidden="true"></span> Incursion
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableNightmares)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="nightmares">
                    <span class="bi bi-nightmare-fill-nav-menu" aria-hidden="true"></span> Nightmares
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableBosses)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="bosses">
                    <span class="bi bi-normal-boss-fill-nav-menu" aria-hidden="true"></span> Bosses
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableInviteBosses)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="invitation-bosses">
                    <span class="bi bi-invite-boss-fill-nav-menu" aria-hidden="true"></span> Invite Bosses
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableUbers)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="ubers">
                    <span class="bi bi-uber-boss-fill-nav-menu" aria-hidden="true"></span> Ubers
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableMoralSupport)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="encouragement">
                    <span class="bi bi-encouragement-fill-nav-menu" aria-hidden="true"></span> Moral Support
                </NavLink>
            </div>
        }

        @if (StoredSettings != null && StoredSettings.EnableT0s)
        {
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="t0">
                    <span class="bi bi-t0-fill-nav-menu" aria-hidden="true"></span> T0 Uniques
                </NavLink>
            </div>
        }
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="settings">
                <span class="bi bi-settings-fill-nav-menu" aria-hidden="true"></span> Settings
            </NavLink>
        </div>
    </nav>
</div>

@code{
    private Settings? StoredSettings;
    protected override async Task OnInitializedAsync()
    {
        StoredSettings = await Repository.GetAsync();
    }
}